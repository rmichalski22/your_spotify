# Copy this file to .env and enter the credentials from your Spotify app.
SPOTIFY_PUBLIC=
SPOTIFY_SECRET=

# These defaults work when you open the app on the Docker host itself.
# For access from another device, use HTTPS URLs reachable from that device.
# If you change the host ports, also change the matching endpoint URLs below.
SERVER_PORT=8080
CLIENT_PORT=3000
API_ENDPOINT=http://127.0.0.1:8080
CLIENT_ENDPOINT=http://127.0.0.1:3000

# Optional. Spotify does not publish a fixed development-mode rate limit.
SPOTIFY_REQUESTS_PER_30_SECONDS=10
